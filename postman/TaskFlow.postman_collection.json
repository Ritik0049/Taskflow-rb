          "// Capture tokens from any auth response so later requests stay authorized.\r",
          "if (pm.response.code === 200 || pm.response.code === 201) {\r",
          "  try {\r",
          "    const json = pm.response.json();\r",
          "    if (json.accessToken) pm.collectionVariables.set(\"accessToken\", json.accessToken);\r",
          "    if (json.refreshToken) pm.collectionVariables.set(\"refreshToken\", json.refreshToken);\r",
          "  } catch (e) {}\r",
          "}"
