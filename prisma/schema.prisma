generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMS ----------

enum TaskStatus {
  todo
  in_progress
  review
  done
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum OrgRole {
  org_admin
  member
}

// ---------- MODELS ----------

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members  OrgMember[]
  projects Project[]

  @@map("organizations")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships   OrgMember[]
  assignments   TaskAssignment[]
  comments      Comment[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model OrgMember {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  orgId    String   @map("org_id")
  role     OrgRole  @default(member)
  joinedAt DateTime @default(now()) @map("joined_at")

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // A user holds exactly one role per organization.
  @@unique([userId, orgId])
  // Every authenticated request resolves membership to derive org context and role.
  @@index([userId, orgId])
  // Admin member-management lists all members of one org.
  @@index([orgId])
  @@map("org_members")
}

model Project {
  id          String    @id @default(uuid())
  orgId       String    @map("org_id")
  name        String
  description String?
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  tasks Task[]

  // Every project query is scoped by org_id; hottest filter in the API.
  @@index([orgId])
  // Active-project listings exclude soft-deleted rows on every read.
  @@index([orgId, deletedAt])
  @@map("projects")
}

model Task {
  id          String       @id @default(uuid())
  projectId   String       @map("project_id")
  title       String
  description String?
  status      TaskStatus   @default(todo)
  priority    TaskPriority @default(medium)
  dueDate     DateTime?    @map("due_date")
  deletedAt   DateTime?    @map("deleted_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignments TaskAssignment[]
  comments    Comment[]

  // Task lists are fetched per project and usually filtered by status.
  @@index([projectId, status])
  // Priority is the second most common filter on the same project-scoped list.
  @@index([projectId, priority])
  // Due-date range filters sort on this column.
  @@index([dueDate])
  @@map("tasks")
}

model TaskAssignment {
  id         String   @id @default(uuid())
  taskId     String   @map("task_id")
  userId     String   @map("user_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Prevents assigning the same user to the same task twice.
  @@unique([taskId, userId])
  // Supports the "filter tasks by assignee" requirement.
  @@index([userId])
  @@map("task_assignments")
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Comment threads load per task, newest first.
  @@index([taskId, createdAt])
  @@map("comments")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Logout-all-devices revokes every active token for one user.
  @@index([userId])
  @@map("refresh_tokens")
}